---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { PLANNED } from '../../site';
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.published - +a.data.published);
const written = new Set(posts.map((p) => p.data.title));
const upcoming = PLANNED.filter((p) => !written.has(p.title));
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog" description="Explainers, comparisons, worked examples and reality checks on Jev, each sourced and dated.">
  <section class="card page-head">
    <p class="eyebrow">Blog</p>
    <h1>Explainers, worked examples and reality checks</h1>
    <p class="lede">Every post names the Jev version it was checked against and the date it was last checked.</p>
  </section>
  {posts.length > 0 && (
    <section class="grid g3">
      {posts.map((p) => (
        <a class="card uc" href={`/blog/${p.id}/`} style="text-decoration: none; color: inherit">
          <div class="uc-top"><span class="tag">{p.data.kind}</span><span class="status">{fmt(p.data.published)}</span></div>
          <h3>{p.data.title}</h3>
          <p class="decides">{p.data.dek}</p>
          <div class="uc-foot"><span class="status">{p.data.readMinutes} min read</span></div>
        </a>
      ))}
    </section>
  )}
  <section class="card">
    <p class="mono-label">{posts.length ? 'Coming next' : 'Our first five posts, in the works'}</p>
    <ol class="rows">
      {upcoming.map((p, i) => <li><span class="n">{String(posts.length + i + 1).padStart(2, '0')}</span><span class="t">{p.title}<span class="d">{p.dek}</span></span><span class="tag">{p.kind}</span></li>)}
    </ol>
  </section>
</Base>
