---
// Home: the blog and the podcast lead; guides support them.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import { getCollection } from 'astro:content';
import { PLANNED } from '../site';
import { USE_CASES } from '../data/usecases';
import { HOWTOS } from '../data/howtos';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.published - +a.data.published);
const episodes = (await getCollection('episodes')).sort((a, b) => b.data.number - a.data.number);
const [lead, ...rest] = posts;
const written = new Set(posts.map((p) => p.data.title));
const upcoming = PLANNED.filter((p) => !written.has(p.title));
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base>
  {lead && (
    <section class="lead-post">
      <article class="card">
        <p class="eyebrow"><b>Latest</b> · {lead.data.kind} · {fmt(lead.data.published)} · {lead.data.readMinutes} min read</p>
        <h1><a href={`/blog/${lead.id}/`}>{lead.data.respondingTo?.lede ?? lead.data.title}</a></h1>
        {lead.data.respondingTo && <p class="quote">“{lead.data.respondingTo.quote}”<span class="small"> · {lead.data.respondingTo.quoteBy ?? lead.data.respondingTo.outlet}</span></p>}
        <p class="lede">{lead.data.dek}</p>
        <div class="btns">
          <a class="btn" href={`/blog/${lead.id}/`}>Read: {lead.data.title} <Icon name="arrow" size={16} stroke={2} /></a>
          {lead.data.episode && <a class="btn ghost" href={`/podcast/${lead.data.episode}/`}><Icon name="headphones" size={16} /> Episode</a>}
        </div>
      </article>
      <div class="card pod-hero">
        <p class="mono-label"><Icon name="mic" size={14} /> The podcast</p>
        <h2>Jev, in plain English</h2>
        <p class="muted">Short episodes that pair with each post. Every source linked in the show notes.</p>
        <ol class="episodes" style="background: var(--surface); border-radius: 8px; padding: 0 10px; color: var(--ink)">{episodes.slice(0, 3).map((ep) => <EpisodeRow ep={ep} />)}</ol>
        <a class="more" style="margin-top: 10px" href="/podcast/">All episodes <Icon name="arrow" size={14} /></a>
      </div>
    </section>
  )}

  <section class="grid g2">
    <div class="card">
      <div class="sec-head" style="margin: 0 0 6px"><h2>From the blog</h2><a class="more" href="/blog/">All posts <Icon name="arrow" size={14} /></a></div>
      <ol class="rows">
        {rest.map((p, i) => <li><span class="n">{String(i + 2).padStart(2, '0')}</span><a class="t" href={`/blog/${p.id}/`}>{p.data.title}<span class="d">{p.data.dek}</span></a><span class="tag">{p.data.kind}</span></li>)}
        {upcoming.map((p, i) => <li><span class="n">{String(posts.length + i + 1).padStart(2, '0')}</span><span class="t">{p.title}<span class="d">{p.dek}</span></span><span class="tag">In the works</span></li>)}
      </ol>
    </div>
    <div class="card">
      <div class="sec-head" style="margin: 0 0 6px"><h2>Guides</h2><a class="more" href="/guides/">All guides <Icon name="arrow" size={14} /></a></div>
      <ol class="rows">
        <li><span class="n">UC</span><a class="t" href="/use-cases/">{USE_CASES.length} use cases<span class="d">What Jev can decide, how well it fits, and where a person must stay in charge.</span></a><span class="tag">Guide</span></li>
        <li><span class="n">IN</span><a class="t" href="/for-agencies/">For insurance agencies<span class="d">Lead scoring, call routing, QA scorecards and claims intake.</span></a><span class="tag">Guide</span></li>
        <li><span class="n">HT</span><a class="t" href="/how-to/">{HOWTOS.length} how-tos<span class="d">From your first call to setting confidence thresholds.</span></a><span class="tag">In the works</span></li>
        <li><span class="n">GL</span><a class="t" href="/glossary/">Glossary<span class="d">Choice, Score, Noul, confidence and the rest, in plain English.</span></a><span class="tag">Guide</span></li>
      </ol>
    </div>
  </section>
</Base>
