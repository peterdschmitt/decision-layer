---
import GuideLinks from '../components/GuideLinks.astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ROLES } from '../site';
const paths: Record<string, { label: string; href: string; note: string }[]> = {
  manager: [
    { label: 'What Jev is, in two minutes', href: '/glossary/#jev', note: 'The one-paragraph version.' },
    { label: 'Use cases with fit ratings', href: '/use-cases/', note: 'Where it fits well, where to test first, where a person must decide.' },
    { label: 'Reality check on the claims', href: '/guides/#reality', note: 'What “zero hallucinations” and “193.6x faster” actually mean.' },
    { label: 'How we test', href: '/tests/', note: 'What a fair test looks like, so you can ask your team for one.' },
  ],
  developer: [
    { label: 'Make your first call', href: '/how-to/', note: 'curl, Python and JavaScript.' },
    { label: 'The three question types', href: '/glossary/#choice', note: 'Choice, Score and Noul, and when each fits.' },
    { label: 'Confidence and routing', href: '/glossary/#confidence', note: 'What confidence measures, and what it doesn’t.' },
    { label: 'Where Jev is weak', href: '/glossary/#jaggedness', note: 'Numbers, dates, long noisy state, option order.' },
  ],
  agency: [
    { label: 'Agency use cases', href: '/for-agencies/', note: 'Leads, routing, QA, compliance checks and claims intake.' },
    { label: 'Ground rules for insurance', href: '/for-agencies/', note: 'Jev sorts, people decide. No protected traits.' },
    { label: 'Lead scoring, worked example', href: '/blog/', note: 'Coming as one of our first five posts.' },
    { label: 'How we test', href: '/tests/', note: 'Synthetic data only; nothing from real policyholders.' },
  ],
};
---
<Base title="Start here" description="Three paths into Jev: for team leads, for developers, and for insurance agencies.">
  <GuideLinks />
  <section class="card page-head">
    <p class="eyebrow">Start here</p>
    <h1>Pick the path that sounds like you</h1>
  </section>
  <section class="grid g3">
    {ROLES.map((r) => (
      <div class="card" id={r.key}>
        <h2>{r.label}</h2>
        <p class="muted">{r.blurb}</p>
        <ol class="rows">
          {paths[r.key].map((p, i) => <li style="grid-template-columns: 26px 1fr"><span class="n">{i + 1}</span><a class="t" href={p.href}>{p.label}<span class="d">{p.note}</span></a></li>)}
        </ol>
      </div>
    ))}
  </section>
</Base>
